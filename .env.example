# Public/runtime configuration. Compose maps DOMINO_ORIGIN to the application's
# ORIGIN variable. For direct development, export DATABASE_URL and ORIGIN.
DOMINO_ORIGIN=http://localhost:3000
DOMINO_PORT=3000
DOMINO_BIND_ADDRESS=127.0.0.1
DOMINO_DEMO_MODE=false
DOMINO_IMAGE_TAG=local
DOMINO_CLI_IMAGE_TAG=local
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Direct-development and external-database settings (Compose supplies its own
# DATABASE_URL). Do not commit real credentials.
# DATABASE_URL=postgres://domino:password@127.0.0.1:5432/domino
DATABASE_POOL_SIZE=10
DOMINO_UPLOAD_DIR=/data/uploads
# HOST=127.0.0.1
# PORT=3000
# BODY_SIZE_LIMIT=55M

# Secret file paths below are host paths consumed by Compose. The matching
# in-container variables are wired to /run/secrets/* in compose.yaml.
DOMINO_SESSION_SECRET_PATH=./secrets/session_secret
DOMINO_CREDENTIAL_ENCRYPTION_KEY_PATH=./secrets/credential_encryption_key
DOMINO_OIDC_CLIENT_SECRET_PATH=./secrets/oidc_client_secret
PAPERLESS_TOKEN_PATH=./secrets/paperless_token

# Direct value forms are supported for local development or a trusted external
# secret injector, but file forms are preferred in production:
# DOMINO_SESSION_SECRET=
# DOMINO_CREDENTIAL_ENCRYPTION_KEY=
# DOMINO_OIDC_CLIENT_SECRET=
# PAPERLESS_TOKEN=

# Optional Paperless-ngx integration. A household setting saved in the UI takes
# precedence over these deployment defaults.
PAPERLESS_URL=https://paperless.example.test
PAPERLESS_TOKEN_FILE=/run/secrets/paperless_token

# Optional OIDC login. Pocket ID callback URL:
# https://domino.example.test/auth/oidc/callback
DOMINO_OIDC_ENABLED=false
DOMINO_OIDC_PROVIDER_NAME=Pocket ID
DOMINO_OIDC_ISSUER=https://id.example.test
DOMINO_OIDC_CLIENT_ID=
DOMINO_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
DOMINO_SESSION_SECRET_FILE=/run/secrets/session_secret
DOMINO_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/credential_encryption_key
DOMINO_OIDC_SCOPES=openid profile email groups
# Leave empty to rely on Pocket ID's client access policy, or use a comma-separated allowlist.
DOMINO_OIDC_ALLOWED_GROUPS=
DOMINO_OIDC_REQUIRE_VERIFIED_EMAIL=true
DOMINO_OIDC_AUTO_PROVISION=true
# Disabled by default: existing accounts require an explicit administrative identity link.
DOMINO_OIDC_LINK_EXISTING_BY_EMAIL=false
DOMINO_OIDC_DEFAULT_ROLE=Member
# Initial claim access for newly auto-provisioned users: all, open, attention, or none.
DOMINO_OIDC_DEFAULT_CLAIM_PRESET=all
# Set this UUID when OIDC should provision into one household among several.
DOMINO_OIDC_HOUSEHOLD_ID=
# The first matching OIDC user may create the initial household and becomes Owner.
DOMINO_OIDC_BOOTSTRAP_OWNER_EMAIL=
DOMINO_HOUSEHOLD_NAME=Home
DOMINO_HOUSEHOLD_SLUG=home
DOMINO_SESSION_TTL_HOURS=168
DOMINO_DEVICE_FLOW_MAX_OUTSTANDING=1000

# Only enable forwarded-address parsing when Domino is reachable exclusively
# through a trusted reverse proxy that overwrites this header. XFF_DEPTH is the
# number of trusted proxy hops between the client and Domino.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# One-time bootstrap helper; prefer its --password-file flag.
# DOMINO_BOOTSTRAP_PASSWORD_FILE=/run/bootstrap/owner_password
