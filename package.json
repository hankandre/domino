    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "lucide-svelte": "^1.0.1",
