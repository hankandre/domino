{
  "name": "domino",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "check:docs": "bun scripts/check-doc-links.ts",
    "check:roles": "node scripts/verify-role-catalog.mjs",
    "check:release:app": "bun scripts/verify-app-release.ts",
    "check:release:cli": "bun scripts/verify-cli-release.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:performance": "bun scripts/performance-baseline.ts",
    "db:studio": "drizzle-kit studio",
    "bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "test": "bun test --path-ignore-patterns '**/*.integration.test.ts'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:integration": "bun -e 'if (!process.env.DATABASE_URL) throw new Error(\"DATABASE_URL is required for integration tests\")' && svelte-kit sync && bun test src/lib/server/**/*.integration.test.ts",
    "cli": "cargo run -p domino-cli --"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@node-rs/argon2": "^2.0.2",
    "@sveltejs/kit": "^2.70.2",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "hono": "^4.12.32",
    "jose": "^6.2.5",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "swagger-ui-dist": "^5.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.12.1",
    "drizzle-kit": "^0.31.10",
    "lucide-svelte": "^1.0.1",
    "nanoid": "^6.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "3.0.0"
  },
  "overrides": {
    "cookie": "1.0.2",
    "esbuild": "0.28.1"
  }
}
