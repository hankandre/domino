# syntax=docker/dockerfile:1.7
FROM docker.io/library/rust:1.95-alpine@sha256:606fd313a0f49743ee2a7bd49a0914bab7deedb12791f3a846a34a4711db7ed2 AS build

RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --locked --release -p domino-cli \
  && mkdir -p /skeleton/home/domino/.config/domino /skeleton/run/domino \
  && chown -R 10001:10001 /skeleton

FROM gcr.io/distroless/static-debian13:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6

ENV HOME=/home/domino \
    XDG_CONFIG_HOME=/home/domino/.config \
    XDG_RUNTIME_DIR=/run

COPY --from=build --chown=10001:10001 /skeleton/home /home
COPY --from=build --chown=10001:10001 /skeleton/run /run
COPY --from=build --chown=10001:10001 /src/target/release/domino /usr/local/bin/domino

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/domino"]
CMD ["--help"]
